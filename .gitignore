# ---------------------------------------------------------------------------
# prematurestop .gitignore
# Tracked: code (src/, tests/, third_party/), experiment configs (experiments/),
# published results (results/), documentation (docs/), environments/.
# Not tracked: anything large, regenerable, personal, or archived.
# ---------------------------------------------------------------------------

# --- archived experiments and notes (kept locally, not published) ----------
archive/

# --- local raw data: traces, per-run records, manifests, corpora, logs ------
# See src/prematurestop/paths.py (LOCAL_DATA / $PREMATURESTOP_LOCAL_DATA).
local_data/

# --- experiment runtime state written next to configs (kept out of git) -----
experiments/**/state/
experiments/**/run_results/
experiments/**/nrp/k8s/rendered/
experiments/**/lambda/*ratings*.csv

# --- files above GitHub's 100 MB limit: committed gzipped (.csv.gz) instead ---
results/whitebox/e1_fixed_cue_matrix/gemma_gptoss/data/answer_run_level.csv

# --- model weights, containers, archives -----------------------------------
*.bin
*.safetensors
*.pt
*.pth
*.sif
*.tar
*.tar.gz
*.tsv.gz
*.zip

# --- logs and cluster output ------------------------------------------------
*.out
*.err
logs/

# --- python / tooling -------------------------------------------------------
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.ipynb_checkpoints/
.cache/
.venv/
venv/

# --- editors / OS / personal -----------------------------------------------
.vscode/
.idea/
.DS_Store
.claude/
/HANDOVER*.md
*.bak

# --- personal: agent instructions and private analysis notes --------------------
CLAUDE.md
/notes/

# scratch output of scripts/thesis_figures (final figures live in results/thesis_figures/)
/results/figures/

# scripts/thesis_figures outputs that are outside the thesis scope (answers / harm) or run logs
/results/thesis_tables/**/*harm*.csv
/results/thesis_tables/e2/e2_accuracy.csv
/results/thesis_tables/e2/e2_mechanism.csv
/results/thesis_tables/**/*.txt
